rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.keys().hasAny(['avora_owner'])
        && request.auth.token.avora_owner == true;
    }

    function validUsername(value) {
      return value is string
        && value.matches('^[a-z][a-z0-9_]{3,19}$')
        && ![
          'admin', 'administrator', 'avora', 'avora_admin', 'avora_owner',
          'moderator', 'official', 'owner', 'root', 'staff', 'support', 'system'
        ].hasAny([value]);
    }

    match /system/counters {
      allow read: if signedIn();
      allow create, delete: if false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUserId'])
        && request.resource.data.lastUserId == resource.data.lastUserId + 1
        && request.resource.data.lastUserId >= 10000000
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.originalAvoraId
          == request.resource.data.lastUserId;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && validUsername(username)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'avoraId', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.avoraId is int
        && request.resource.data.avoraId >= 10000000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          == username
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.originalAvoraId
          == request.resource.data.avoraId;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid) || isOwner();
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'originalAvoraId', 'username', 'role', 'authorityRole',
          'commerceRole', 'staffAssignments', 'scopeType', 'countryCode',
          'managerId', 'bdId', 'agencyId', 'displayName', 'createdAt',
          'usernameChangedAt'
        ])
        && request.resource.data.originalAvoraId is int
        && request.resource.data.originalAvoraId >= 10000000
        && validUsername(request.resource.data.username)
        && request.resource.data.role == 'user'
        && request.resource.data.authorityRole == 'user'
        && request.resource.data.commerceRole == 'none'
        && request.resource.data.staffAssignments.size() == 0
        && request.resource.data.scopeType == 'self'
        && request.resource.data.createdAt == request.time
        && request.resource.data.usernameChangedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid
          == uid
        && getAfter(/databases/$(database)/documents/system/counters).data.lastUserId
          == request.resource.data.originalAvoraId;
      allow update: if (owns(uid) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'bio', 'countryCode', 'photoUrl', 'updatedAt'
            ])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2
            && request.resource.data.displayName.size() <= 60
            && (!request.resource.data.keys().hasAny(['bio'])
              || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 240))
            && (!request.resource.data.keys().hasAny(['countryCode'])
              || request.resource.data.countryCode == null
              || request.resource.data.countryCode.matches('^[A-Z]{2}$'))
            && (!request.resource.data.keys().hasAny(['photoUrl'])
              || request.resource.data.photoUrl == null
              || (request.resource.data.photoUrl is string
                && request.resource.data.photoUrl.size() <= 2048))
            && request.resource.data.updatedAt == request.time)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'username', 'usernameChangedAt', 'updatedAt'
            ])
            && validUsername(request.resource.data.username)
            && request.resource.data.username != resource.data.username
            && request.resource.data.usernameChangedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.time >= resource.data.usernameChangedAt + duration.value(30, 'd')
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.avoraId == resource.data.originalAvoraId
            && getAfter(/databases/$(database)/documents/usernameHistory/$(resource.data.username)).data.uid == uid
            && getAfter(/databases/$(database)/documents/usernameHistory/$(resource.data.username)).data.replacementUsername == request.resource.data.username))
        )
        || isOwner();
      allow delete: if false;
    }

    match /ownerAccess/{uid} {
      allow read: if owns(uid) || isOwner();
      allow write: if false;
    }

    match /usernameHistory/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernameHistory/$(username))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'replacementUsername', 'avoraId', 'reservedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && validUsername(request.resource.data.replacementUsername)
        && request.resource.data.avoraId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.originalAvoraId
        && request.resource.data.reservedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.replacementUsername;
      allow update, delete: if false;
    }

    match /identityAudit/{auditId} {
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'action', 'uid', 'oldUsername', 'newUsername', 'createdAt'
        ])
        && request.resource.data.action == 'username.rename'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.oldUsername
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.newUsername;
      allow update, delete: if false;
    }

    match /privilegedAudit/{auditId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /policy_acceptances/{uid} {
      allow read: if owns(uid) || isOwner();
      allow create: if owns(uid)
        && request.resource.data.avoraUid == uid
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn()
        && (resource.data.status == 'active'
          || resource.data.ownerUid == request.auth.uid
          || isOwner());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'description', 'status', 'visibility',
          'memberCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.status == 'active'
        && request.resource.data.visibility == 'public'
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.role == 'host';
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isOwner())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'uid', 'role', 'status', 'joinedAt', 'lastActiveAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastActiveAt == request.time
          && ((request.resource.data.role == 'host'
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == uid)
            || request.resource.data.role == 'member');
        allow update: if owns(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'body', 'status', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
          && (resource.data.senderUid == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
            || isOwner())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'moderatedAt', 'moderatedBy'
          ])
          && request.resource.data.status in ['deleted', 'moderated']
          && request.resource.data.moderatedAt == request.time
          && request.resource.data.moderatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read: if signedIn()
        && (resource.data.blockerUid == request.auth.uid || isOwner());
      allow create: if signedIn()
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.keys().hasOnly([
          'blockerUid', 'blockedUid', 'createdAt'
        ])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'targetUid', 'conversationId', 'category',
          'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.category in [
          'direct_message', 'profile', 'room', 'game'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.targetUid == resource.data.targetUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && resource.data.participantUids is list
        && resource.data.participantUids.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantUids', 'participantNames', 'createdBy', 'status',
          'lastMessage', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0]
          != request.resource.data.participantUids[1]
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.lastMessage == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.participantNames == resource.data.participantNames
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastSenderUid', 'updatedAt', 'status'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.participantUids.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.participantUids.hasAny([request.auth.uid])
          && request.resource.data.keys().hasOnly([
            'senderUid', 'body', 'status', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/blocks/$(
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantUids[0] + '_' +
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantUids[1]))
          && !exists(/databases/$(database)/documents/blocks/$(
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantUids[1] + '_' +
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantUids[0]));
        allow update: if signedIn()
          && (resource.data.senderUid == request.auth.uid || isOwner())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'moderatedAt', 'moderatedBy'
          ])
          && request.resource.data.status in ['deleted', 'moderated']
          && request.resource.data.moderatedAt == request.time
          && request.resource.data.moderatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
