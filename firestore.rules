rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && request.resource.data.originalAvoraId is int
        && request.resource.data.role == 'user';

      allow update: if owns(uid)
        && request.resource.data.originalAvoraId == resource.data.originalAvoraId
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }


    match /publicProfiles/{uid} {
      allow read: if signedIn();

      allow create: if owns(uid)
        && request.resource.data.originalAvoraId is int
        && request.resource.data.keys().hasOnly([
          'originalAvoraId', 'displayName', 'photoDataUrl', 'photoUrl',
          'bio', 'country', 'countryCode', 'richLevel', 'charmLevel',
          'vipLevel', 'friendsCount', 'followersCount', 'followingCount',
          'verified', 'updatedAt'
        ]);

      allow update: if owns(uid)
        && request.resource.data.originalAvoraId == resource.data.originalAvoraId
        && request.resource.data.keys().hasOnly([
          'originalAvoraId', 'displayName', 'photoDataUrl', 'photoUrl',
          'bio', 'country', 'countryCode', 'richLevel', 'charmLevel',
          'vipLevel', 'friendsCount', 'followersCount', 'followingCount',
          'verified', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /system/counters {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastUserId'])
        && request.resource.data.lastUserId == resource.data.lastUserId + 1
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.originalAvoraId == request.resource.data.lastUserId;
      allow create, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.seatCount is int
        && request.resource.data.seatCount >= 4
        && request.resource.data.seatCount <= 20
        && request.resource.data.memberCount == 1
        && request.resource.data.active == true;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerAvoraId == resource.data.ownerAvoraId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if owns(uid)
          && request.resource.data.userUid == uid
          && request.resource.data.seatIndex is int;
        allow update: if owns(uid)
          && resource.data.userUid == uid
          && request.resource.data.userUid == uid;
        allow delete: if owns(uid)
          && resource.data.userUid == uid;
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if signedIn()
        && resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
